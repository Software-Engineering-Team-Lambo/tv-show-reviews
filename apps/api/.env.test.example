# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

# if using devcontainer, the database url is already set up for you, but you still need
# the TMDB_API_KEY below
# the database name is suffixed with _test for the test environment
# this should mirror the DATABASE_URL in .env but with a different database name
DATABASE_URL="mysql://johndoe:randompassword@localhost:3306/mydb_example_test"

# get it from https://www.themoviedb.org/settings/api after signing up
# you can usually use the same key for dev and test environments
TMDB_API_KEY="<your_tmdb_api_key_here>"

# JWT secret for authentication (generate a strong random string)
# this is fine for dev and test, but make sure to change it in production
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"