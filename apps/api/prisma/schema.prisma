// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  username      String   @unique
  password_hash String
  reviews   Review[]
  createdAt DateTime @default(now())
}

model Show {
  id          Int      @id @default(autoincrement())
  title       String
  popularity  Float?
  description String?  @db.Text
  posterPath  String?
  releaseDate DateTime?
  seasons     Int?
  episodes    Int?
  status      String?  // e.g., "Ongoing", "Ended"
  creators    ShowCreator[]
  reviews     Review[]
  genres      ShowGenre[]
  cast        ShowCast[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Creator {
  id    Int           @id // TMDB creator ID
  name  String
  shows ShowCreator[]
  
  createdAt DateTime @default(now())
}

model ShowCreator {
  show      Show    @relation(fields: [showId], references: [id], onDelete: Cascade)
  showId    Int
  creator   Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  creatorId Int

  @@id([showId, creatorId])
}

model Genre {
  id    Int         @id @default(autoincrement())
  name  String      @unique // e.g., "Drama", "Comedy", "Sci-Fi"
  shows ShowGenre[]
}

model ShowGenre {
  show    Show   @relation(fields: [showId], references: [id], onDelete: Cascade)
  showId  Int
  genre   Genre  @relation(fields: [genreId], references: [id], onDelete: Cascade)
  genreId Int

  @@id([showId, genreId])
}

model Actor {
  id    Int        @id @default(autoincrement())
  name  String
  shows ShowCast[]
  
  createdAt DateTime @default(now())
}

model ShowCast {
  show      Show   @relation(fields: [showId], references: [id], onDelete: Cascade)
  showId    Int
  actor     Actor  @relation(fields: [actorId], references: [id], onDelete: Cascade)
  actorId   Int
  role      String? // Optional: character name
  order     Int?    // Optional: billing order (1 = lead, 2 = supporting, etc.)

  @@id([showId, actorId])
}

model Review {
  id        Int      @id @default(autoincrement())
  rating    Int
  comment   String?
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  show      Show     @relation(fields: [showId], references: [id])
  showId    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, showId]) // Ensure a user can only review a show once
}