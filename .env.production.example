# Production environment variables
# This file should NEVER be committed to git
# Copy this to .env.production on your VM and fill in secure values

# MySQL Configuration
MYSQL_ROOT_PASSWORD=CHANGE_ME_secure_root_password_here
MYSQL_DATABASE=tvshowreviews
MYSQL_USER=tvapp
MYSQL_PASSWORD=CHANGE_ME_secure_app_password_here

# Application Configuration
NODE_ENV=production

# TMDB API Key (for seeding data - only needed if you run seed script)
TMDB_API_KEY=your_tmdb_api_key_here

# Add any other API keys or secrets here
# JWT_SECRET=your_jwt_secret_here
