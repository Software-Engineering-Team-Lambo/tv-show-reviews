# Production environment variables
# This file should NEVER be committed to git
# Copy this to .env.production on your VM and fill in secure values

# MySQL Configuration
MYSQL_ROOT_PASSWORD=CHANGE_ME_secure_root_password_here
MYSQL_DATABASE=tvshowreviews
MYSQL_USER=tvapp
MYSQL_PASSWORD=CHANGE_ME_secure_app_password_here

# Application Configuration
NODE_ENV=production

# Database URL (used by Prisma in the API)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# Note: Use 'db' as the host (Docker service name)
DATABASE_URL=mysql://tvapp:CHANGE_ME_secure_app_password_here@db:3306/tvshowreviews

# Add any API keys or secrets here
# JWT_SECRET=your_jwt_secret_here
# EXTERNAL_API_KEY=your_api_key_here
