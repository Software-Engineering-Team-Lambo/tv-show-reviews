couchcritics.org {
    # Proxy API requests
    handle /api/* {
        reverse_proxy api:3000
    }

    # Serve Vue SPA static files (as a fallback)
    handle {
        root * /srv/web
        encode gzip
        
        # Try to serve static files, fallback to index.html for SPA routing
        try_files {path} /index.html
        file_server
    }

    # Logs
    log {
        output file /data/access.log
        format json
    }
}

# Optional: Redirect www to non-www
www.couchcritics.org {
    redir https://couchcritics.org{uri} permanent
}
